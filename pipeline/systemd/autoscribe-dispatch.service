[Unit]
Description=AutoScribe alpha dispatch coordinator
After=default.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
EnvironmentFile=%h/.config/autoscribe/autoscribe.env
ExecStart=/opt/autoscribe/.venv/bin/python /opt/autoscribe/app/daemon/dispatchd.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=5
Environment=PYTHONUNBUFFERED=1
CPUQuota=10%
MemoryMax=256M
TasksMax=32
Nice=10
NoNewPrivileges=yes

[Install]
WantedBy=default.target
