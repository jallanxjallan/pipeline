[Unit]
Description=AutoScribe Git response writer
After=redis-server.service

[Service]
Type=simple
EnvironmentFile=%h/.config/autoscribe/autoscribe.env
ExecStart=/opt/autoscribe/.venv/bin/python /opt/autoscribe/app/daemon/responsed.py
Restart=on-failure
RestartSec=2
MemoryMax=256M
NoNewPrivileges=yes

[Install]
WantedBy=default.target
