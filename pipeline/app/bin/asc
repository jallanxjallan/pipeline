#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

APP_ROOT = Path(__file__).resolve().parents[1]
if str(APP_ROOT) not in sys.path:
    sys.path.insert(0, str(APP_ROOT))

from autoscribe.control import list_plans
from autoscribe.enqueue import enqueue_record
from autoscribe.exporter import iter_pending_ndjson, poke_responses, response_content
from autoscribe.ids import new_ulid
from autoscribe.ledger import latest_response_id, load_call_keys, load_response
from autoscribe.redis_runtime import RedisClient, load_json


def control_db_path() -> Path:
    return Path(os.environ.get("AUTOSCRIBE_CONTROL_DB", "/var/lib/autoscribe/control.sqlite"))


def ledger_path() -> Path:
    return Path(os.environ.get("AUTOSCRIBE_LEDGER_DB", str(Path.home() / "Data/ledger.sql")))


def redis_client() -> RedisClient:
    host = os.environ.get("AUTOSCRIBE_REDIS_HOST", "127.0.0.1")
    port = int(os.environ.get("AUTOSCRIBE_REDIS_PORT", "6379"))
    return RedisClient(host, port)


def services_bin_dir() -> Path:
    return Path(
        os.environ.get(
            "AUTOSCRIBE_SERVICES_BIN",
            "/opt/autoscribe/services/current/bin",
        )
    )


def services_policy_path() -> Path:
    return Path(
        os.environ.get(
            "AUTOSCRIBE_SERVICES_POLICY",
            "/etc/autoscribe/services.toml",
        )
    )


def run_service(name: str, *args: str, input_text: str) -> str:
    binary = services_bin_dir() / name
    try:
        proc = subprocess.run(
            [
                str(binary),
                "--policy",
                str(services_policy_path()),
                *args,
            ],
            input=input_text,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except FileNotFoundError as exc:
        raise RuntimeError(f"service binary not found: {binary}") from exc
    if proc.returncode != 0:
        detail = proc.stderr.strip() or proc.stdout.strip() or f"exit {proc.returncode}"
        raise RuntimeError(f"{name} failed: {detail}")
    return proc.stdout


def one_ndjson_record(text: str, label: str) -> dict:
    lines = [line for line in text.splitlines() if line.strip()]
    if len(lines) != 1:
        raise RuntimeError(f"{label} returned {len(lines)} records; expected exactly one")
    try:
        value = json.loads(lines[0])
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"{label} returned invalid JSON: {exc}") from exc
    if not isinstance(value, dict):
        raise RuntimeError(f"{label} returned a non-object record")
    return value


def force_export(call_id_arg: str) -> dict:
    call_id = (
        latest_response_id(ledger_path())
        if call_id_arg == "--latest"
        else call_id_arg
    )
    response = response_record(call_id)
    replay_id = f"rpl_{new_ulid()}"
    response_ndjson = (
        json.dumps(
            response,
            ensure_ascii=False,
            sort_keys=True,
            separators=(",", ":"),
        )
        + "\n"
    )

    effect_ndjson = run_service(
        "srv-output",
        "--replay-id",
        replay_id,
        input_text=response_ndjson,
    )
    effect_record = one_ndjson_record(effect_ndjson, "srv-output")
    effect = effect_record.get("effect")
    if not isinstance(effect, dict):
        raise RuntimeError("srv-output returned no effect object")

    kind = effect.get("kind")
    if kind == "repo":
        sink = "srv-writeback"
    elif kind == "dropbox":
        sink = "srv-export"
    else:
        raise RuntimeError(f"unsupported replay effect kind: {kind!r}")

    receipt_ndjson = run_service(sink, input_text=effect_ndjson)
    receipt = one_ndjson_record(receipt_ndjson, sink)
    return {
        "schema": "autoscribe.reexport-result.v1",
        "call_id": call_id,
        "replay_id": replay_id,
        "effect_key": effect_record.get("effect_key"),
        "receipt": receipt,
    }


def enqueue_stdin() -> int:
    client = redis_client()
    count = 0
    for line_number, raw in enumerate(sys.stdin, start=1):
        if not raw.strip():
            continue
        try:
            record = json.loads(raw)
            result = enqueue_record(
                record=record,
                control_db=control_db_path(),
                ledger_db=ledger_path(),
                client=client,
            )
        except Exception as exc:
            print(f"asc enqueue: line {line_number}: {exc}", file=sys.stderr)
            return 1
        print(
            json.dumps(
                {
                    "schema": "autoscribe.enqueue-result.v1",
                    "record_id": result.record_id,
                    "call_id": result.call_id,
                    "created": result.created,
                },
                sort_keys=True,
                separators=(",", ":"),
            )
        )
        count += 1
    if count == 0:
        print("asc enqueue: no input records", file=sys.stderr)
        return 1
    return 0


def response_record(call_id: str) -> dict:
    client = redis_client()
    response = load_response(ledger_path(), call_id)
    response_key = str(response["redis_key"])
    response_hash = client.hgetall(response_key)
    if not response_hash or "content" not in response_hash:
        raise RuntimeError(f"missing response Redis hash: {response_key}")
    keys = load_call_keys(ledger_path(), call_id)
    baggage = load_json(client, keys["baggage"])
    return {
        "schema": "autoscribe.response.v1",
        "call_id": call_id,
        "content": response_hash["content"],
        "baggage": baggage,
    }


def main() -> int:
    args = sys.argv[1:]
    if args == ["control", "plans"]:
        for row in list_plans(control_db_path()):
            print(f"{row['label']}\t{row['id']}")
        return 0
    if args == ["enqueue"]:
        return enqueue_stdin()
    if len(args) == 2 and args[0] == "response":
        try:
            print(json.dumps(response_record(args[1]), ensure_ascii=False, sort_keys=True, separators=(",", ":")))
        except Exception as exc:
            print(f"asc response: {exc}", file=sys.stderr)
            return 1
        return 0
    if args == ["export"]:
        socket_path = Path(
            os.environ.get(
                "AUTOSCRIBE_RESPONSE_SOCKET",
                str(Path.home() / ".local/run/autoscribe/response.sock"),
            )
        )
        try:
            count = poke_responses(ledger_path(), socket_path)
        except Exception as exc:
            print(f"asc export: {exc}", file=sys.stderr)
            return 1
        print(count)
        return 0
    if len(args) == 3 and args[:2] == ["export", "force"]:
        try:
            result = force_export(args[2])
        except Exception as exc:
            print(f"asc export force: {exc}", file=sys.stderr)
            return 1
        print(
            json.dumps(
                result,
                ensure_ascii=False,
                sort_keys=True,
                separators=(",", ":"),
            )
        )
        return 0
    if args == ["export", "pending"]:
        for line in iter_pending_ndjson(ledger_path(), redis_client()):
            print(line)
        return 0
    if len(args) == 3 and args[:2] == ["export", "content"]:
        try:
            content = response_content(ledger_path(), redis_client(), args[2])
        except Exception as exc:
            print(f"asc export content: {exc}", file=sys.stderr)
            return 1
        sys.stdout.write(content)
        return 0
    print(
        "usage: asc control plans | asc enqueue | asc response <call-id> | "
        "asc export | asc export force <call-id|--latest> | "
        "asc export pending | asc export content <call-id>",
        file=sys.stderr,
    )
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
